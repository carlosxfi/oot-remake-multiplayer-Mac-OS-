+#ifdef _WIN32
+    char cmd[MAX_PATH * 5];
+    int n = snprintf(cmd, sizeof cmd, "\"%s\" -I -B \"%s\" --in-game --mods \"%s\"", python, tool, mods_dir);
+    if (n > 0 && (size_t)n < sizeof cmd && romfs[0]) n += snprintf(cmd + n, sizeof cmd - (size_t)n, " --romfs \"%s\"", romfs);
