+// Texture overrides are owned by a live texture serial, under g_smu.
+typedef struct {
+    uint64_t address, size, serial;
+    uint32_t width, height, levels, format;
+} CoopTexture;
+static NSMutableDictionary<NSNumber *, NSData *> *g_coop_texels;
+static _Atomic unsigned g_coop_override_count;
+static uint64_t g_coop_texture_generation;
+
+static int coop_texture_sample(const void *ptr, tex_t *out) {
+    vm_size_t got = 0;
+    return ptr && vm_read_overwrite(mach_task_self(), (vm_address_t)(uintptr_t)ptr,
+        sizeof *out, (vm_address_t)(uintptr_t)out, &got) == KERN_SUCCESS &&
+        got == sizeof *out && out->magic == MAGIC('T', 'E', 'X', 0) &&
+        out->mem && out->L.size && out->L.size <= (32u << 20) &&
+        out->d.target == NVN_TEXTURE_TARGET_2D && out->d.samples <= 1 &&
+        !(out->d.flags & (NVN_TEXTURE_FLAGS_LINEAR | NVN_TEXTURE_FLAGS_LINEAR_RENDER_TARGET |
+                          NVN_TEXTURE_FLAGS_IMAGE | NVN_TEXTURE_FLAGS_COMPRESSIBLE));
+}
+
+__attribute__((visibility("default")))
+int hos_coop_textures(uint64_t min, uint64_t max, CoopTexture *out, int cap, uint64_t *generation) {
+    pthread_mutex_lock(&g_smu);
+    int count = 0;
+    if (generation) *generation = g_coop_texture_generation;
+    if (min > max) {
+        pthread_mutex_unlock(&g_smu);
+        return 0;
+    }
+    for (uint32_t i = 0; i < g_tex_live.cap; ++i) {
+        tex_t t;
+        if (!coop_texture_sample(g_tex_live.vals[i], &t) ||
+            t.L.size < min || t.L.size > max) continue;
+        if (out && count < cap)
+            out[count] = (CoopTexture){(uint64_t)(uintptr_t)t.mem, t.L.size, t.serial,
+                                      t.d.width, t.d.height, t.d.levels, t.d.format};
+        ++count;
+    }
+    pthread_mutex_unlock(&g_smu);
+    return count;
+}
+
+__attribute__((visibility("default")))
+int hos_coop_texture_override(uint64_t address, uint64_t serial, const void *bytes, uint64_t size) {
+    pthread_mutex_lock(&g_smu);
+    tex_t t;
+    const int ok = coop_texture_sample(nvn_hm_get(&g_tex_live, &serial), &t) &&
+                   t.serial == serial && address == (uint64_t)(uintptr_t)t.mem &&
+                   size && size <= t.L.size;
+    if (ok) {
+        if (bytes) {
+            if (!g_coop_texels) g_coop_texels = [NSMutableDictionary dictionary];
+            g_coop_texels[@(serial)] = [NSData dataWithBytes:bytes length:size];
+        } else {
+            [g_coop_texels removeObjectForKey:@(serial)];
+        }
+        atomic_store(&g_coop_override_count, (unsigned)g_coop_texels.count);
+        own_note(serial);
+    }
+    pthread_mutex_unlock(&g_smu);
+    return ok;
+}
+
+NSData *own_coop_texels(uint64_t serial) {
+    if (!atomic_load(&g_coop_override_count)) return nil;
+    pthread_mutex_lock(&g_smu);
+    NSData *bytes = g_coop_texels[@(serial)];
+    pthread_mutex_unlock(&g_smu);
+    return bytes;
+}
