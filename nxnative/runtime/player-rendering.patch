+// Optional camera capture for a co-op overlay. The callbacks are installed
+// once and remain valid for the lifetime of the process.
+typedef int (*dm_camera_wanted_fn)(uint64_t, float, float);
+typedef void (*dm_camera_publish_fn)(uint64_t, const float *, float, float);
