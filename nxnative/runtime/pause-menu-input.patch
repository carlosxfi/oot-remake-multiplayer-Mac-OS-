+// Optional host-side filter for a co-op pause menu. Register once after loading the co-op module.
+typedef uint64_t (*DmCoopPadFilter)(uint64_t buttons, int32_t axes[4]);
+static _Atomic(DmCoopPadFilter) g_coop_pad_filter;
+
+__attribute__((visibility("default")))
+int dm_coop_set_pad_filter(DmCoopPadFilter filter) {
+    DmCoopPadFilter expected = NULL;
+    return filter && atomic_compare_exchange_strong(&g_coop_pad_filter, &expected, filter);
+}
+
+static void fill(NpadState *s, uint32_t id, uint32_t style) {
+    fill_unfiltered(s, id, style);
+    DmCoopPadFilter filter = atomic_load(&g_coop_pad_filter);
+    if (!filter || !s->attributes || (id != NPAD_NO1 && id != NPAD_HANDHELD)) return;
+
+    int32_t axes[4] = {s->lx, s->ly, s->rx, s->ry};
+    s->buttons = filter(s->buttons, axes);
+    s->lx = axes[0]; s->ly = axes[1];
+    s->rx = axes[2]; s->ry = axes[3];
+}
