diff --git a/dm/tools/character_select_ips.py b/dm/tools/character_select_ips.py
new file mode 100644
index 0000000..b986b23
--- /dev/null
+++ b/dm/tools/character_select_ips.py
@@ -0,0 +1,51 @@
+"""Apply an explicitly selected Character Select IPS32 to the main NSO image."""
+import re
+from pathlib import Path
+
+
+def apply_ips(module, path):
+    name = Path(path).stem
+    if not re.fullmatch(r"[0-9a-fA-F]{32,64}", name) or len(name) % 2:
+        raise ValueError("name the IPS32 file with its target NSO build ID")
+    if bytes.fromhex(name).rstrip(b"\0") != module.build_id.rstrip(b"\0"):
+        raise ValueError("the Character Select patch targets a different game build")
+
+    data = Path(path).read_bytes()
+    if not data.startswith(b"IPS32"):
+        raise ValueError("expected an IPS32 patch")
+    at = 5
+    writes = []
+    text_end = module.text_end
+    ro_start = module.segments[1][0]
+    while data[at:at + 4] != b"EEOF":
+        if at + 6 > len(data):
+            raise ValueError("truncated IPS32 record")
+        offset = int.from_bytes(data[at:at + 4], "big") - 0x100
+        size = int.from_bytes(data[at + 4:at + 6], "big")
+        at += 6
+        if size:
+            if at + size > len(data):
+                raise ValueError("truncated IPS32 data")
+            payload = data[at:at + size]
+            at += size
+        else:
+            if at + 3 > len(data):
+                raise ValueError("truncated IPS32 run")
+            size = int.from_bytes(data[at:at + 2], "big")
+            if not size:
+                raise ValueError("empty IPS32 run")
+            payload = data[at + 2:at + 3] * size
+            at += 3
+        end = offset + size
+        if 0 <= offset < ro_start and end <= ro_start:
+            text_end = max(text_end, (end + 3) & ~3)
+        elif not (ro_start <= offset < end <= module.segments[2][0]
+                  or module.segments[2][0] <= offset < end <= len(module.image)):
+            raise ValueError(f"IPS32 write outside a mapped segment at {offset:#x}")
+        writes.append((offset, payload))
+
+    if at + 4 != len(data) or not writes:
+        raise ValueError("unexpected IPS32 trailer or empty patch")
+    image = bytearray(module.image)
+    for offset, payload in writes:
+        image[offset:offset + len(payload)] = payload
+    return module._replace(image=image, segments=((0, text_end), *module.segments[1:]))
